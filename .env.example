# Copy to .env locally. Never upload .env or expose credentials in the browser.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# Required by Docker Compose only; use a separate strong root password.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=proppilot_showcase
# fixture: deterministic sample without model charges; live: real Qwen + RAG
APP_MODE=fixture
COOKIE_SECURE=false
SESSION_DAILY_QUOTA=40
GLOBAL_DAILY_QUOTA=300
DASHSCOPE_API_KEY=
RERANK_URL=
CHAT_MODEL=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
